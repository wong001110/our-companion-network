# Railway service name: network-api
NODE_ENV=production
PORT=3001
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Generate two different values with: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# The Portal is reverse-proxied to this API, but its browser Origin must still
# be explicitly allowed. Generate the Portal public domain before finalizing.
PORTAL_ORIGINS=https://${{network-portal.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGIN=https://${{network-portal.RAILWAY_PUBLIC_DOMAIN}}
PORTAL_COOKIE_SECURE=true
PORTAL_COOKIE_SAME_SITE=strict

PRESENCE_DISCONNECT_GRACE_SECONDS=45
PROTOCOL_VERSION=0.4
MINIMUM_CLIENT_VERSION=0.4.0
SERVER_VERSION=0.4.0
VISIT_INVITATION_TTL_HOURS=24
VISIT_PREPARATION_TTL_MINUTES=10
VISIT_SESSION_MAX_MINUTES=30
VISIT_HEARTBEAT_INTERVAL_SECONDS=15
VISIT_HEARTBEAT_TIMEOUT_SECONDS=60

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=replace-me
R2_BUCKET_NAME=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
R2_REGION=auto
R2_MAX_ASSET_FILE_BYTES=20971520
R2_MAX_ASSET_PACK_BYTES=524288000
R2_MAX_ASSET_PACK_FILES=1000
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=900
R2_UPLOAD_SESSION_TTL_HOURS=24
R2_SUPERSEDED_PACK_RETENTION_DAYS=30
R2_MAX_USER_STORAGE_BYTES=2147483648

# Initial Caretaker account. Use a unique email, username and strong password.
INITIAL_SUPERADMIN_EMAIL=replace-me@example.com
INITIAL_SUPERADMIN_USERNAME=replace-me
INITIAL_SUPERADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_SUPERADMIN_RESET_PASSWORD=false

DEVELOPER_DEBUG_INGEST_ENABLED=false
